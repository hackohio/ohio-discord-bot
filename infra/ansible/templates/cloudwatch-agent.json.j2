{
  "agent": {
    "metrics_collection_interval": 60,
    "region": "{{ aws_region }}"
  },
  "metrics": {
    "namespace": "HackOHIO/Lightsail",
    "aggregation_dimensions": [["host"]],
    "metrics_collected": {
      "mem": {
        "measurement": ["mem_available"]
      },
      "disk": {
        "drop_original_metrics": ["disk_used_percent"],
        "resources": ["/"],
        "measurement": ["used_percent"]
      }
    }
  }
}
