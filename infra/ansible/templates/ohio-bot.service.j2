[Unit]
Description=OHI/O Discord bot and registration webhook
After=network-online.target
Wants=network-online.target

[Service]
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_dir }}
RuntimeDirectory=ohio-bot
Environment=HOME={{ app_home }}
Environment=OHIO_DISCORD_READY_FILE=/run/ohio-bot/discord.ready
ExecStartPre=/usr/bin/rm -f /run/ohio-bot/discord.ready
ExecStart=/usr/local/bin/uv run --frozen python start.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
